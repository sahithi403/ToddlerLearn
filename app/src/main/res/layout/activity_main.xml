<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟 Let's Learn!"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_learn"
            android:textSize="18sp"
            android:textColor="#FFAAC8C4"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Category Buttons - Horizontal Scrollable -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <Button
                android:id="@+id/btnPeople"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="👨‍👩‍👧 మనుషులు"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cat_people"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnAnimals"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🐾 జంతువులు"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cat_animals"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnObjects"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🧸 వస్తువులు"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cat_objects"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnColors"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🎨 రంగులు"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cat_colors"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnShapes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:text="🔷 ఆకారాలు"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/cat_shapes"
                android:textColor="@color/white" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Grid of items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

</LinearLayout>
